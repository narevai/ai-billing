{
  "name": "ai-billing-monorepo",
  "packageManager": "pnpm@10.34.6+sha512.7e1ae66a83a9143c118cc1944f37cc4f2b8acddeda4b001cfa78908f6e46e45e15292739ca6c9d026426cc757e9318cc98c5551d6a16c165097b0028ba87b4e6",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=\"./packages/*\"",
    "build:apps": "turbo run build --filter=\"./apps/*\"",
    "build:examples": "turbo run build --filter=\"./examples/*\" --filter=\"./examples/utils/*\"",
    "dev": "turbo run dev",
    "docs": "turbo run docs:generate --filter=docs",
    "lint": "turbo run lint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check-types": "turbo run check-types",
    "knip": "turbo run //#knip:check",
    "knip:check": "knip",
    "storybook": "turbo run dev --filter=ai-billing-storybook",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:coverage": "turbo run test --filter=\"./packages/*\" -- --coverage"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint-plugin-jsdoc": "catalog:",
    "eslint-plugin-tsdoc": "catalog:",
    "knip": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsup": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "resolutions": {
    "jsondiffpatch": ">=0.7.6",
    "sharp": ">=0.35.0",
    "postcss": ">=8.5.23",
    "@opentelemetry/core": ">=2.8.0"
  }
}
