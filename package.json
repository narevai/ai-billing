{
  "name": "ai-billing-monorepo",
  "packageManager": "pnpm@10.34.7+sha512.ba98abc585539933375b5971f4bc6d6c73a1b4b7edc4a879e7d102fe5423d1e02309d67c60a11f04955093a96e521ad9c3b138cdd654ca5be563f378b3ae48bd",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=\"./packages/*\"",
    "build:apps": "turbo run build --filter=\"./apps/*\"",
    "build:examples": "turbo run build --filter=\"./examples/*\" --filter=\"./examples/utils/*\"",
    "dev": "turbo run dev",
    "docs": "turbo run docs:generate --filter=docs",
    "lint": "turbo run lint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check-types": "turbo run check-types",
    "knip": "turbo run //#knip:check",
    "knip:check": "knip",
    "storybook": "turbo run dev --filter=ai-billing-storybook",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:coverage": "turbo run test --filter=\"./packages/*\" -- --coverage"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint-plugin-jsdoc": "catalog:",
    "eslint-plugin-tsdoc": "catalog:",
    "knip": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsup": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "resolutions": {
    "jsondiffpatch": ">=0.7.6",
    "sharp": ">=0.35.0",
    "postcss": ">=8.5.23",
    "@opentelemetry/core": ">=2.8.0"
  }
}
