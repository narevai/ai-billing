{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": [
    "next",
    "tsup",
    "eslint-plugin-jsdoc",
    "eslint-plugin-tsdoc",
    "typedoc-plugin-markdown"
  ],
  "ignore": [
    "examples/utils/**",
    "examples/chatbot-with-billing/**",
    "apps/storybook/**"
  ],
  "workspaces": {
    "packages/nextjs": {
      "ignoreDependencies": ["jsondiffpatch"]
    },
    "packages/openrouter": {
      "ignoreDependencies": ["undici"]
    },
    "examples/dev-sandbox": {
      "ignoreDependencies": ["@basetenlabs/performance-client"]
    }
  }
}
